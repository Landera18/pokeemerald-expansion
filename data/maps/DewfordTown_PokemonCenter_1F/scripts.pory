raw`DewfordTown_PokemonCenter_1F_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, DewfordTown_PokemonCenter_1F_OnTransition
	map_script MAP_SCRIPT_ON_RESUME, CableClub_OnResume
	.byte 0

DewfordTown_PokemonCenter_1F_OnTransition:
	setrespawn HEAL_LOCATION_DEWFORD_TOWN
	call Common_EventScript_UpdateBrineyLocation
	end

DewfordTown_PokemonCenter_1F_EventScript_Nurse::
	setvar VAR_0x800B, LOCALID_DEWFORD_NURSE
	call Common_EventScript_PkmnCenterNurse
	waitmessage
	waitbuttonpress
	release
	end

DewfordTown_PokemonCenter_1F_EventScript_PokefanF::
	msgbox DewfordTown_PokemonCenter_1F_Text_StoneCavern, MSGBOX_NPC
	end

DewfordTown_PokemonCenter_1F_EventScript_Man::
	msgbox DewfordTown_PokemonCenter_1F_Text_FaintedMonCanUseHM, MSGBOX_NPC
	end

DewfordTown_PokemonCenter_1F_Text_StoneCavern:
	.string "There's a stone cavern at the edge\n"
	.string "of town.\p"
	.string "I've heard you can find rare stones\n"
	.string "there.$"

DewfordTown_PokemonCenter_1F_Text_FaintedMonCanUseHM:
	.string "Even if a POKéMON faints and can't\n"
	.string "battle, it can still use a move learned\l"
	.string "from a HIDDEN MACHINE (HM).$"
`

script DewfordTown_PokemonCenter_1F_HyperTraining {
    lock
    faceplayer
    msgbox(format("For one BOTTLE CAP, I can hyper train one of your POKéMON. Would you like to hyper train a POKéMON?"))
	checkitem(ITEM_BOTTLE_CAP, 1)
		if(var(VAR_RESULT) == 0) {
		msgbox(format("You don't have any Bottle Caps.$"))
        release
        end
    }
	special(ChoosePartyMon)
    if (var(VAR_0x8004) == PARTY_NOTHING_CHOSEN) {
        releaseall
        end
    }
    msgbox(format("Which stat would you like to hyper train?"))
    waitbuttonpress
    dynmultichoice(0, 0, TRUE, 3, 0, DYN_MULTICHOICE_CB_NONE, "HP", "ATTACK", "DEFENSE", "SP. ATK", "SP. DEF", "SPEED", "Cancel")
    buffernumberstring(STR_VAR_1, VAR_RESULT)
switch (var(VAR_RESULT)) {
    case 0: // HP
        hypertrain(STAT_HP, VAR_0x8004)
        goto(HyperTrain_Done3)

    case 1: // Attack
        hypertrain(STAT_ATK, VAR_0x8004)
        goto(HyperTrain_Done3)

    case 2: // Defense
        hypertrain(STAT_DEF, VAR_0x8004)
        goto(HyperTrain_Done3)

    case 3: // Sp. Atk
        hypertrain(STAT_SPATK, VAR_0x8004)
        goto(HyperTrain_Done3)

    case 4: // Sp. Def
        hypertrain(STAT_SPDEF, VAR_0x8004)
        goto(HyperTrain_Done3)

    case 5: // Speed
        hypertrain(STAT_SPEED, VAR_0x8004)
        goto(HyperTrain_Done3)

    case 6: // Cancel
        msgbox(format("Maybe another time then."))
        releaseall
        end
}

// Common end for all successful choices
HyperTrain_Done3:
removeitem(ITEM_BOTTLE_CAP, 1)
msgbox(format("Your POKéMON has been hyper trained! Its base stat has been maximized."))
releaseall
end

    }
raw`MossdeepCity_PokemonCenter_1F_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, MossdeepCity_PokemonCenter_1F_OnTransition
	map_script MAP_SCRIPT_ON_RESUME, CableClub_OnResume
	.byte 0

MossdeepCity_PokemonCenter_1F_OnTransition:
	setrespawn HEAL_LOCATION_MOSSDEEP_CITY
	end

MossdeepCity_PokemonCenter_1F_EventScript_Nurse::
	setvar VAR_0x800B, LOCALID_MOSSDEEP_NURSE
	call Common_EventScript_PkmnCenterNurse
	waitmessage
	waitbuttonpress
	release
	end

MossdeepCity_PokemonCenter_1F_EventScript_Woman::
	msgbox MossdeepCity_PokemonCenter_1F_Text_GymLeaderDuoFormidable, MSGBOX_NPC
	end

MossdeepCity_PokemonCenter_1F_EventScript_Girl::
	msgbox MossdeepCity_PokemonCenter_1F_Text_AbilitiesMightChangeMoves, MSGBOX_NPC
	end

MossdeepCity_PokemonCenter_1F_Text_GymLeaderDuoFormidable:
	.string "The GYM LEADERS in this town are\n"
	.string "a formidable duo.\p"
	.string "Their combination attacks are, like,\n"
	.string "excellent and wow!$"

MossdeepCity_PokemonCenter_1F_Text_AbilitiesMightChangeMoves:
	.string "Depending on the special abilities of\n"
	.string "POKéMON, some moves might change\l"
	.string "or not work at all.$"

`

script MossdeepCity_PokemonCenter_1F_HyperTraining {
    lock
    faceplayer
    msgbox(format("For one BOTTLE CAP, I can hyper train one of your POKéMON. Would you like to hyper train a POKéMON?"))
	checkitem(ITEM_BOTTLE_CAP, 1)
		if(var(VAR_RESULT) == 0) {
		msgbox(format("You don't have any Bottle Caps.$"))
        release
        end
    }
	special(ChoosePartyMon)
    if (var(VAR_0x8004) == PARTY_NOTHING_CHOSEN) {
        releaseall
        end
    }
    msgbox(format("Which stat would you like to hyper train?"))
    waitbuttonpress
    dynmultichoice(0, 0, TRUE, 3, 0, DYN_MULTICHOICE_CB_NONE, "HP", "ATTACK", "DEFENSE", "SP. ATK", "SP. DEF", "SPEED", "Cancel")
    buffernumberstring(STR_VAR_1, VAR_RESULT)
switch (var(VAR_RESULT)) {
    case 0: // HP
        hypertrain(STAT_HP, VAR_0x8004)
        goto(HyperTrain_Done9)

    case 1: // Attack
        hypertrain(STAT_ATK, VAR_0x8004)
        goto(HyperTrain_Done9)

    case 2: // Defense
        hypertrain(STAT_DEF, VAR_0x8004)
        goto(HyperTrain_Done9)

    case 3: // Sp. Atk
        hypertrain(STAT_SPATK, VAR_0x8004)
        goto(HyperTrain_Done9)

    case 4: // Sp. Def
        hypertrain(STAT_SPDEF, VAR_0x8004)
        goto(HyperTrain_Done9)

    case 5: // Speed
        hypertrain(STAT_SPEED, VAR_0x8004)
        goto(HyperTrain_Done9)

    case 6: // Cancel
        msgbox(format("Maybe another time then."))
        releaseall
        end
}

// Common end for all successful choices
HyperTrain_Done9:
removeitem(ITEM_BOTTLE_CAP, 1)
msgbox(format("Your POKéMON has been hyper trained! Its base stat has been maximized."))
releaseall
end

    }